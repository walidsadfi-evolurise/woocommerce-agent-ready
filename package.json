{
  "name": "woocommerce-agent-ready",
  "version": "0.1.0",
  "description": "Audit a WooCommerce store for agentic commerce readiness: Store API, product data, structured data, robots, MCP, cart and performance. Score out of 100 with actionable fixes.",
  "keywords": [
    "woocommerce",
    "agentic-commerce",
    "mcp",
    "acp",
    "ai-agents",
    "audit",
    "store-api",
    "structured-data"
  ],
  "author": "Walid Sadfi <walid.sadfi@evolurise.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/walidsadfi-evolurise/woocommerce-agent-ready.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "woo-agent-ready": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "check": "npm run typecheck && npm run lint && npm run test",
    "prepublishOnly": "npm run check && npm run build"
  },
  "dependencies": {
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@types/node": "^22.15.3",
    "eslint": "^9.26.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.1",
    "vitest": "^3.1.3"
  }
}
